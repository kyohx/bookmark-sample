{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {
      "()": "src.libs.log_formatter.JsonFormatter"
    }
  },
  "handlers": {
    "json": {
      "class": "logging.StreamHandler",
      "formatter": "json",
      "stream": "ext://sys.stdout"
    }
  },
  "root": {
    "level": "INFO",
    "handlers": ["json"]
  },
  "loggers": {
    "uvicorn": {
      "level": "INFO",
      "handlers": ["json"],
      "propagate": false
    },
    "uvicorn.error": {
      "level": "INFO",
      "handlers": [],
      "propagate": true
    },
    "uvicorn.access": {
      "level": "INFO",
      "handlers": [],
      "propagate": true
    },
    "sqlalchemy.engine.Engine": {
      "level": "WARNING",
      "handlers": ["json"],
      "propagate": false
    }
  }
}
